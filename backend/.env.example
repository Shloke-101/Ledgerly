# PREVIA Backend Environment Configuration

# Server Settings
API_TITLE=PREVIA API
API_VERSION=1.0.0
API_HOST=127.0.0.1
API_PORT=8000

# Database Configuration (Defaults to SQLite for zero-config local run; supports PostgreSQL)
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./previa.db
# Or PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/previa

# Redis (Optional: Used for caching and Celery tasks; standalone in-memory fallback is automatic)
REDIS_URL=redis://localhost:6379/0

# GitHub API Token (Optional but recommended for high-volume GitHub scanning)
GITHUB_TOKEN=

# Anthropic Claude API Key (Optional: for AI supply-chain remediation summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Cache & Rate Limiting
OSV_CACHE_TTL=86400
OSV_RATE_LIMIT_SECONDS=0.25
