# ==============================================================================
# PREVIA - Root Environment Configuration Example
# ==============================================================================

# Backend Server
API_HOST=127.0.0.1
API_PORT=8000
API_TITLE=PREVIA API
API_VERSION=1.0.0

# Database Configuration (SQLite for local standalone; PostgreSQL for production/Docker)
DATABASE_URL=sqlite+aiosqlite:///./previa.db
# DATABASE_URL=postgresql+asyncpg://ledgerly:ledgerly@localhost:5432/ledgerly

# Redis Cache & Message Broker (Optional for standalone; automatic in-memory fallback)
REDIS_URL=redis://localhost:6379/0

# GitHub Integration (Optional: increases rate limits for repository fetching)
GITHUB_TOKEN=

# Anthropic Claude API Key (Optional: enables AI supply-chain remediation summaries)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001